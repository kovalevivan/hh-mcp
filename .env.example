# HeadHunter OAuth application credentials (получить на https://dev.hh.kz/admin)
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here

# Required by HH API rules — иначе 403. Подставь свой контакт.
HH_USER_AGENT=hh-mcp/0.1.0 (your-email@example.com)

# Где принимать OAuth-callback. Для CLI используем out-of-band: пользователь копирует
# код из адресной строки руками. Если зарегистрировал свой URL — подставь его.
HH_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Базовые URL — менять обычно не нужно.
HH_AUTH_BASE=https://hh.kz
HH_API_BASE=https://api.hh.ru

# Опционально — стартовать с уже готовыми токенами (иначе пройди OAuth через hh_auth).
# HH_ACCESS_TOKEN=
# HH_REFRESH_TOKEN=

# HTTP-режим: bearer-токен для авторизации запросов на /mcp. Пусто = open server.
# MCP_AUTH_TOKEN=
