HH_MCP_REVISION=replace-with-git-commit
MCP_AUTH_TOKEN=replace-with-random-access-token
HH_USER_AGENT=hh-mcp/0.1.1 (+https://github.com/kovalevivan/hh-mcp)
HH_AUTH_BASE=https://hh.ru
HH_API_BASE=https://api.hh.ru
# Add registered employer application credentials to enable HH OAuth:
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
# Optional LibreChat administration bridge (independent keys, not HH credentials):
# HH_ADMIN_TOKEN=
# HH_CONFIG_KEY=
# HH_ADMIN_REDIRECT_URI=https://admin.artdent-ai.ru/headhunter-callback
# HH_OAUTH_STATE_TTL_MS=600000
